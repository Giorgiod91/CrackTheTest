# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Keine echten Secrets in dieser Datei committen.

# ────────────────────────────────────────────────
# Supabase (Auth + Datenbank)
# ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Nur serverseitig, nie mit NEXT_PUBLIC_ versehen
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ────────────────────────────────────────────────
# Stripe (Prüfungspaket, Einmalzahlung)
# ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
# Stripe Dashboard > Webhooks, Endpoint: https://your-domain.de/api/webhook/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Basis-URL für Stripe-Redirects
NEXT_PUBLIC_APP_URL="https://your-domain.de"

# ────────────────────────────────────────────────
# Anthropic (KI-Übungstests)
# ────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ────────────────────────────────────────────────
# Vercel Cron (Supabase-Keepalive)
# ────────────────────────────────────────────────
CRON_SECRET="random-string"
